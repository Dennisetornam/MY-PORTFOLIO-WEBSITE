RewriteEngine On
RewriteBase /

# Remove .php extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# Prevent directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "^(db\.php|config\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch> 